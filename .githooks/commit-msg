#!/bin/sh
# Versioned commit-msg hook. Enable it with:
#   git config core.hooksPath .githooks
#
# 1. Strips any Co-Authored-By line naming Claude or Anthropic, and any
#    Claude-Session line.
# 2. Rejects the commit if the message contains an em dash or an en dash.

set -e

msg_file="$1"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

tmp_file="$msg_file.recof.tmp"

# Case insensitive, tolerates leading whitespace.
sed -E \
    -e '/^[[:space:]]*[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:.*([Cc][Ll][Aa][Uu][Dd][Ee]|[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]).*$/d' \
    -e '/^[[:space:]]*[Cc][Ll][Aa][Uu][Dd][Ee]-[Ss][Ee][Ss][Ss][Ii][Oo][Nn]:.*$/d' \
    "$msg_file" > "$tmp_file"
mv "$tmp_file" "$msg_file"

em_dash=$(printf '\342\200\224')
en_dash=$(printf '\342\200\223')

# Comment lines are dropped by git before the message is stored, so they are
# not checked.
if grep -v '^#' "$msg_file" | grep -q -e "$em_dash" -e "$en_dash"; then
    echo "commit-msg: the message contains an em dash or an en dash." >&2
    echo "commit-msg: use a comma, a colon, parentheses or a plain hyphen." >&2
    exit 1
fi

exit 0
